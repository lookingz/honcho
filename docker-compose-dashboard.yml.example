# Honcho dashboard overlay for Docker Compose
#
# Usage:
#   cp docker-compose-dashboard.yml.example docker-compose-dashboard.yml
#   cp .env.template .env  # edit with your provider config
#   docker compose -f docker-compose.yml -f docker-compose-dashboard.yml up -d --build
#
# By default, ports are bound to 127.0.0.1 (localhost only).

services:
  dashboard:
    image: ghcr.io/tolkonepiu/honcho-dashboard:latest
    container_name: honcho-dashboard
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      - HONCHO_BASE_URL=http://honcho-api-1:8000
    depends_on:
      - api
    restart: unless-stopped
